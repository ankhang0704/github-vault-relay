{
  "name": "github-vault-relay",
  "version": "1.1.0",
  "description": "A conservative GitHub bridge for mobile and desktop vault sync without requiring Git on the phone.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "git",
    "github",
    "sync",
    "mobile",
    "ios"
  ],
  "author": "Vault Relay Contributors",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^15.15.0",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.3"
  }
}
